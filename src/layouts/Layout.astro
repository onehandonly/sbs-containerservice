---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Override canonical URL (defaults to current page) */
  canonical?: string;
  /** OG image absolute URL */
  ogImage?: string;
  /** Set to false to noindex the page (e.g. /lp/, /danke) */
  index?: boolean;
  /** LCP hero image path for preload hint (e.g. "/img/lagercontainer.jpg") */
  lcpImage?: string;
}

const {
  title,
  description = 'SBS Containerservice GmbH – Ihr zuverlässiger Partner für Bürocontainer, Lagercontainer und Sanitärcontainer.',
  canonical,
  ogImage,
  index = true,
  lcpImage,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// GTM container ID — set via PUBLIC_GTM_ID env variable, left empty in dev
const gtmId = import.meta.env.PUBLIC_GTM_ID ?? '';

// LocalBusiness JSON-LD — real values come from env vars (set in hosting config)
// Placeholders are clearly labelled so missing data doesn't produce incorrect schema
const phone = import.meta.env.PUBLIC_PHONE ?? null;
const email = import.meta.env.PUBLIC_EMAIL ?? null;
const streetAddress = import.meta.env.PUBLIC_ADDRESS_STREET ?? null;
const addressLocality = import.meta.env.PUBLIC_ADDRESS_CITY ?? null;
const postalCode = import.meta.env.PUBLIC_ADDRESS_POSTCODE ?? null;
const siteUrl = Astro.site?.href ?? 'https://www.sbs-container.de';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'SBS Containerservice GmbH',
  description: 'Verkauf von Bürocontainern, Lagercontainern und Sanitärcontainern für Gewerbe, Handwerk und Industrie.',
  url: siteUrl,
  ...(phone ? { telephone: phone } : {}),
  ...(email ? { email } : {}),
  ...(streetAddress && addressLocality && postalCode
    ? {
        address: {
          '@type': 'PostalAddress',
          streetAddress,
          addressLocality,
          postalCode,
          addressCountry: 'DE',
        },
      }
    : {}),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
      opens: '07:00',
      closes: '16:15',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Friday'],
      opens: '07:00',
      closes: '13:00',
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking font load: preload as style, swap to stylesheet on load -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Jost:wght@400;600;700;800&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@400;600;700;800&display=swap" /></noscript>
    {lcpImage && <link rel="preload" href={lcpImage} as="image" fetchpriority="high" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={index ? 'index,follow' : 'noindex,nofollow'} />

    <!-- LocalBusiness structured data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>

    <!-- Google Tag Manager — injected only when GTM_ID is configured -->
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer', gtmId);
      </script>
    )}
  </head>
  <body>
    <!-- GTM noscript fallback -->
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        />
      </noscript>
    )}

    <a href="#main-content" class="skip-link">Zum Hauptinhalt springen</a>
    <slot />

    <!-- Analytics event bridge: pushes dataLayer events for GTM triggers -->
    <script src="../scripts/analytics.ts"></script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -9999px;
    left: 1rem;
    background-color: var(--color-brand-primary);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    z-index: 9999;
    transition: top 0.1s;
  }

  .skip-link:focus-visible {
    top: 1rem;
    outline: 2px solid white;
    outline-offset: 2px;
  }
</style>
