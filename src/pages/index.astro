---
import Layout from '../layouts/Layout.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import Benefits from '../components/sections/Benefits.astro';
import ContactForm from '../components/sections/ContactForm.astro';

const phone = '+49 (0) 000 000 000';
---

<Layout
  title="SBS Containerservice GmbH – Container mieten & Entsorgung"
  description="SBS Containerservice GmbH – Schnelle Container-Lieferung für Privat und Gewerbe. Bauschutt, Sperrmüll, Grünschnitt. Jetzt Angebot anfragen!"
>
  <Header phone={phone} />

  <main id="main-content">
    <Hero
      headline="Container mieten – schnell und unkompliziert"
      subline="Zuverlässige Container-Lieferung in Ihrer Region. Faire Preise, kurzfristige Verfügbarkeit – für Privat und Gewerbe."
      ctaLabel="Jetzt Angebot anfragen"
      ctaHref="#kontakt"
    />

    <Services />
    <Benefits />
    <ContactForm phone={phone} />
  </main>

  <Footer />
</Layout>
