---
import Layout from '../layouts/Layout.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import Benefits from '../components/sections/Benefits.astro';
import ContactForm from '../components/sections/ContactForm.astro';

const phone = '+49 (0) 4282 594650';
---

<Layout
  title="SBS Containerservice GmbH – Bürocontainer, Lagercontainer & Sanitärcontainer kaufen"
  description="SBS Containerservice GmbH – Hochwertige Bürocontainer, Lagercontainer und Sanitärcontainer direkt kaufen. Faire Preise, schnelle Lieferung – für Privat und Gewerbe."
>
  <Header phone={phone} />

  <main id="main-content">
    <Hero
      headline="Container kaufen – direkt und unkompliziert"
      subline="Hochwertige Bürocontainer, Lagercontainer und Sanitärcontainer für Privat und Gewerbe. Faire Preise und schnelle Lieferung in Ihre Region."
      ctaLabel="Jetzt Angebot anfragen"
      ctaHref="#kontakt"
    />

    <Services />
    <Benefits />
    <ContactForm phone={phone} />
  </main>

  <Footer />
</Layout>
