---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
---

<Layout
  title="SBS Containerservice GmbH – Container & Entsorgung"
  description="SBS Containerservice GmbH – Schnelle und zuverlässige Container-Lieferung für Privat und Gewerbe. Jetzt anfragen und Sofortangebot erhalten."
>
  <Hero
    headline="Container einfach bestellen"
    subline="Schnelle Lieferung, faire Preise – für Privat und Gewerbe in Ihrer Region."
    ctaLabel="Jetzt Angebot anfragen"
    ctaHref="#kontakt"
  />

  <main id="main-content">
    <section id="kontakt" aria-labelledby="kontakt-heading">
      <div style="max-width:72rem;margin-inline:auto;padding:var(--space-section) var(--space-gap)">
        <h2 id="kontakt-heading" style="font-size:var(--text-2xl);font-weight:700;margin-bottom:1rem">
          Kontakt & Anfrage
        </h2>
        <p style="color:var(--color-text-muted)">Kontaktformular folgt in Kürze.</p>
      </div>
    </section>
  </main>
</Layout>
