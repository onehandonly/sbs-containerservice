---
import LandingLayout from '../../layouts/LandingLayout.astro';
import LandingHero from '../../components/lp/LandingHero.astro';
import LandingFeatures from '../../components/lp/LandingFeatures.astro';
import LandingForm from '../../components/lp/LandingForm.astro';

const gtmLabel = 'lp_buerocontainer';

const features = [
  {
    icon: '<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>',
    title: 'Sofort einsatzbereit',
    body: 'Unsere Bürocontainer werden komplett eingerichtet geliefert: Strom, LED-Beleuchtung und Heizung.',
  },
  {
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    title: 'Wettergeschützt & robust',
    body: 'Hochwertige Stahlkonstruktion, wärmegedämmt und witterungsbeständig. Für Innen- und Außeneinsatz geeignet.',
  },
  {
    icon: '<circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>',
    title: 'Flexibel kombinierbar',
    body: 'Mehrere Einheiten lassen sich zu großen Büroflächen verbinden. Ideal für wachsende Teams und wachsende Projekte.',
  },
  {
    icon: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
    title: 'Transparente Festpreise',
    body: 'Kein Kleingedrucktes. Unser Angebot gilt ab Anfrage – inklusive Lieferung und Aufstellung.',
  },
];
---

<LandingLayout
  title="Bürocontainer kaufen – sofort verfügbar | SBS Container GmbH"
  description="Bürocontainer kaufen: robust, wärmegedämmt, sofort einsatzbereit. Faire Festpreise, schnelle Lieferung. Jetzt kostenloses Angebot anfragen!"
  canonical="https://www.sbs-container.de/lp/buerocontainer-kaufen"
>
  <LandingHero
    headline="Bürocontainer kaufen – robust, flexibel, sofort einsatzbereit"
    subline="Hochwertige Bürocontainer für Baustellen, Büros und Veranstaltungen."
    ctaLabel="Jetzt Angebot anfragen"
    ctaHref="#anfrage"
    gtmLabel={gtmLabel}
    badge="Kostenlos & unverbindlich"
  />

  <LandingFeatures
    heading="Warum SBS Bürocontainer?"
    features={features}
  />

  <!-- Product overview section -->
  <section class="product-info" aria-labelledby="product-heading">
    <div class="product-info__inner">
      <h2 id="product-heading" class="product-info__heading">Bürocontainer – Modelle & Ausstattung</h2>
      <p class="product-info__sub">Alle Einheiten werden auf Wunsch individuell ausgestattet. Sprechen Sie uns an.</p>
      <ul class="product-grid" role="list">
        <li class="product-card">
          <span class="product-card__size">10 Fuß</span>
          <span class="product-card__use">Einzelbüro, ca. 9 m²</span>
          <ul class="product-card__features">
            <li>Schreibtisch & Stuhl</li>
            <li>LED-Beleuchtung</li>
            <li>Heizung & Lüftung</li>
          </ul>
          <span class="product-card__cta">Preis auf Anfrage</span>
        </li>
        <li class="product-card product-card--featured">
          <span class="product-card__badge">Beliebt</span>
          <span class="product-card__size">20 Fuß</span>
          <span class="product-card__use">Teambüro, ca. 15 m²</span>
          <ul class="product-card__features">
            <li>2–4 Arbeitsplätze</li>
            <li>Isolierverglasung</li>
            <li>Elektroinstallation</li>
          </ul>
          <span class="product-card__cta">Preis auf Anfrage</span>
        </li>
        <li class="product-card">
          <span class="product-card__size">Kombination</span>
          <span class="product-card__use">Mehrere Einheiten</span>
          <ul class="product-card__features">
            <li>Individuell konfigurierbar</li>
            <li>Innenverbindung möglich</li>
            <li>Für größere Teams</li>
          </ul>
          <span class="product-card__cta">Preis auf Anfrage</span>
        </li>
        <li class="product-card product-card--wide">
          <span class="product-card__size">Baustellencontainer</span>
          <span class="product-card__use">Bürocontainer mit integriertem Sanitärbereich</span>
          <ul class="product-card__features">
            <li>Büro + WC-Abteil in einer Einheit</li>
            <li>Optional mit Dusche</li>
            <li>Ideal für Baustellen ohne Sanitäranschluss</li>
          </ul>
          <span class="product-card__cta">Preis auf Anfrage</span>
        </li>
      </ul>
    </div>
  </section>

  <LandingForm
    ctaLabel="Jetzt Angebot anfragen"
    gtmLabel={gtmLabel}
    selectVariant="buero-nutzung"
    formHeading="Kostenloses Angebot in 2 Minuten"
    formSubheading="Beschreiben Sie Ihren Bedarf – wir melden uns innerhalb von 3 Stunden mit einem Festpreisangebot."
  />
</LandingLayout>

<style>
  .product-info {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .product-info__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
    text-align: center;
  }

  .product-info__heading {
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .product-info__sub {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .product-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    max-width: 56rem;
    margin-inline: auto;
  }

  .product-card {
    position: relative;
    background-color: var(--color-surface-alt);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    text-align: center;
    transition: border-color var(--duration-fast);
  }

  .product-card--featured {
    border-color: var(--color-brand-primary);
    background-color: color-mix(in srgb, var(--color-brand-primary) 5%, white);
  }

  .product-card__badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-brand-primary);
    color: white;
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
  }

  .product-card__size {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--color-brand-primary);
    line-height: 1;
  }

  .product-card__use {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .product-card__features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-text);
    margin-top: 0.5rem;
  }

  .product-card__cta {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-brand-accent);
    margin-top: 0.5rem;
  }

  .product-card--wide {
    grid-column: 1 / -1;
    max-width: 36rem;
    margin-inline: auto;
    background-color: color-mix(in srgb, var(--color-brand-accent) 5%, white);
    border-color: var(--color-brand-accent);
  }

  @media (max-width: 640px) {
    .product-grid {
      grid-template-columns: 1fr;
      max-width: 22rem;
    }
  }
</style>
