---
import LandingLayout from '../../layouts/LandingLayout.astro';
import LandingHero from '../../components/lp/LandingHero.astro';
import LandingFeatures from '../../components/lp/LandingFeatures.astro';
import LandingForm from '../../components/lp/LandingForm.astro';

const gtmLabel = 'lp_gruenschnitt';

const features = [
  {
    icon: '<path d="M12 22V12"/><path d="M5 3l7 9 7-9"/><path d="M5 3h14"/>',
    title: 'Alle Grünschnitt-Arten',
    body: 'Äste, Rasenschnitt, Laub, Hecken, Strauchwerk – alles in einem Container. Keine Sortierung nötig.',
  },
  {
    icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
    title: 'Schnelle Lieferung',
    body: 'Gerade im Frühjahr und Herbst sind Kapazitäten knapp. Bestellen Sie jetzt – wir liefern noch diese Woche.',
  },
  {
    icon: '<path d="M21.5 2l-5.5 5.5"/><path d="M18.5 2h3v3"/><path d="M2 21.5l5.5-5.5"/><path d="M5.5 22h-3v-3"/><path d="M4 4l16 16"/>',
    title: 'Kompostierung & Recycling',
    body: 'Ihr Grünschnitt wird fachgerecht kompostiert – kein CO₂-Anstieg durch illegale Verbrennung.',
  },
  {
    icon: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
    title: 'Saisonales Sonderangebot',
    body: 'Sparen Sie mit unserem Frühjahrs- und Herbstangebot: Grünschnitt-Container zu attraktiven Konditionen.',
  },
];
---

<LandingLayout
  title="Grünschnitt Container mieten — Garten entsorgen leicht gemacht | SBS Containerservice"
  description="Grünschnitt Container schnell geliefert. Äste, Rasenschnitt, Hecken – alles rein. Saisonales Angebot, Lieferung diese Woche. Jetzt anfragen."
  canonical="https://www.sbs-containerservice.de/lp/gruenschnitt-container"
>
  <LandingHero
    headline="Grünschnitt-Container mieten – schnell und unkompliziert"
    subline="Perfekt für Frühjahrs- und Herbstarbeiten. Einfach alles rein: Äste, Laub, Rasenschnitt, Hecken. Schnelle Lieferung, unkomplizierte Abholung."
    ctaLabel="Grünschnitt Container anfragen"
    ctaHref="#anfrage"
    gtmLabel={gtmLabel}
    badge="Saisonangebot aktiv"
  />

  <!-- Seasonal offer banner -->
  <section class="seasonal-banner" aria-label="Saisonales Angebot">
    <div class="seasonal-banner__inner">
      <div class="seasonal-banner__icon" aria-hidden="true">🌿</div>
      <div>
        <p class="seasonal-banner__title">Frühjahr-Sonderangebot: Grünschnitt-Container besonders günstig</p>
        <p class="seasonal-banner__sub">Begrenzte Kapazitäten — jetzt anfragen und Termin sichern.</p>
      </div>
      <a
        href="#anfrage"
        class="seasonal-banner__cta"
        data-gtm-event="cta_click"
        data-gtm-label={gtmLabel}
      >
        Angebot sichern
      </a>
    </div>
  </section>

  <!-- What goes in -->
  <section class="green-waste-section" aria-labelledby="green-waste-heading">
    <div class="green-waste-section__inner">
      <h2 id="green-waste-heading" class="green-waste-section__heading">Was darf in den Grünschnitt-Container?</h2>
      <div class="green-waste-grid">
        <div class="green-waste-item green-waste-item--yes">
          <div class="green-waste-item__check" aria-hidden="true">✓</div>
          <span>Äste & Zweige</span>
        </div>
        <div class="green-waste-item green-waste-item--yes">
          <div class="green-waste-item__check" aria-hidden="true">✓</div>
          <span>Rasenschnitt</span>
        </div>
        <div class="green-waste-item green-waste-item--yes">
          <div class="green-waste-item__check" aria-hidden="true">✓</div>
          <span>Laub & Herbstlaub</span>
        </div>
        <div class="green-waste-item green-waste-item--yes">
          <div class="green-waste-item__check" aria-hidden="true">✓</div>
          <span>Hecken & Strauchwerk</span>
        </div>
        <div class="green-waste-item green-waste-item--yes">
          <div class="green-waste-item__check" aria-hidden="true">✓</div>
          <span>Baumschnitt</span>
        </div>
        <div class="green-waste-item green-waste-item--yes">
          <div class="green-waste-item__check" aria-hidden="true">✓</div>
          <span>Pflanzenreste</span>
        </div>
        <div class="green-waste-item green-waste-item--no">
          <div class="green-waste-item__check" aria-hidden="true">✗</div>
          <span>Bauschutt</span>
        </div>
        <div class="green-waste-item green-waste-item--no">
          <div class="green-waste-item__check" aria-hidden="true">✗</div>
          <span>Hausmüll</span>
        </div>
        <div class="green-waste-item green-waste-item--no">
          <div class="green-waste-item__check" aria-hidden="true">✗</div>
          <span>Erde & Steine</span>
        </div>
      </div>
    </div>
  </section>

  <LandingFeatures
    heading="Warum SBS für Ihren Garten?"
    features={features}
  />

  <LandingForm
    ctaLabel="Grünschnitt Container anfragen"
    gtmLabel={gtmLabel}
    selectVariant="menge"
    formHeading="Saisonangebot jetzt sichern"
    formSubheading="Begrenzte Containerkapazitäten im Frühjahr und Herbst. Jetzt anfragen und Wunschtermin erhalten."
  />
</LandingLayout>

<style>
  .seasonal-banner {
    background-color: oklch(92% 0.08 150 / 40%);
    border-bottom: 1.5px solid oklch(60% 0.12 150 / 30%);
    padding-block: 1.25rem;
  }

  .seasonal-banner__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .seasonal-banner__icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .seasonal-banner__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: oklch(30% 0.12 150);
  }

  .seasonal-banner__sub {
    font-size: var(--text-sm);
    color: oklch(40% 0.10 150);
    margin-top: 0.25rem;
  }

  .seasonal-banner__cta {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    background-color: oklch(45% 0.14 150);
    color: white;
    font-size: var(--text-sm);
    font-weight: 700;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: opacity var(--duration-fast);
    flex-shrink: 0;
  }

  .seasonal-banner__cta:hover {
    opacity: 0.85;
  }

  .green-waste-section {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    background-color: var(--color-surface);
  }

  .green-waste-section__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
  }

  .green-waste-section__heading {
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
    text-align: center;
  }

  .green-waste-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.875rem;
    max-width: 52rem;
    margin-inline: auto;
  }

  .green-waste-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: var(--radius-md);
    padding: 0.875rem 1rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .green-waste-item--yes {
    background-color: oklch(92% 0.08 150 / 30%);
    border: 1px solid oklch(60% 0.12 150 / 25%);
    color: oklch(30% 0.10 150);
  }

  .green-waste-item--no {
    background-color: oklch(93% 0.06 20 / 25%);
    border: 1px solid oklch(60% 0.10 20 / 20%);
    color: oklch(40% 0.10 20);
  }

  .green-waste-item__check {
    font-size: 1rem;
    font-weight: 900;
    flex-shrink: 0;
  }
</style>
