---
import LandingLayout from '../../layouts/LandingLayout.astro';
import LandingHero from '../../components/lp/LandingHero.astro';
import LandingFeatures from '../../components/lp/LandingFeatures.astro';
import Benefits from '../../components/sections/Benefits.astro';
import LandingForm from '../../components/lp/LandingForm.astro';

const gtmLabel = 'lp_wohncontainer';

const features = [
  {
    icon: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
    title: 'Wohnkomfort auf kleinem Raum',
    body: 'Unsere Wohncontainer bieten vollwertige Wohnlösungen mit Küche, Bad und Schlafbereich – sofort bezugsfertig.',
  },
  {
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    title: 'Wärmegedämmt & wetterfest',
    body: 'Hochwertige Isolierung sorgt für angenehmes Raumklima zu jeder Jahreszeit. Robuste Stahlkonstruktion für dauerhaften Einsatz.',
  },
  {
    icon: '<circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>',
    title: 'Flexibel erweiterbar',
    body: 'Einzelmodule oder Kombinationen – passen Sie den Wohnraum an Ihre Bedürfnisse an. Ideal für temporäre und dauerhafte Nutzung.',
  },
  {
    icon: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
    title: 'Transparente Festpreise',
    body: 'Kein Kleingedrucktes. Festpreis ab Anfrage – inklusive Lieferung und Aufstellung vor Ort.',
  },
];
---

<LandingLayout
  title="Wohncontainer kaufen – sofort bezugsfertig | SBS Container GmbH"
  description="Wohncontainer kaufen: wärmegedämmt, komplett ausgestattet, sofort bezugsfertig. Faire Festpreise, schnelle Lieferung. Jetzt kostenloses Angebot anfragen!"
  canonical="https://anfrage.sbs-containerservice.de/wohncontainer-kaufen"
  lcpImage="/img/buerocontainer-perspektive.png"
>
  <LandingHero
    headline="Wohncontainer kaufen – komfortabel, flexibel, sofort bezugsfertig"
    subline="Hochwertige Wohncontainer für temporäres Wohnen, Unterkünfte für Mitarbeiter und als flexible Raumlösungen."
    ctaLabel="Jetzt Angebot anfragen"
    ctaHref="#anfrage"
    gtmLabel={gtmLabel}
    badge="Kostenlos & unverbindlich"
    image="/img/buerocontainer-perspektive.png"
    imageAlt="SBS Wohncontainer – wärmegedämmt und komfortabel"
  />

  <LandingFeatures
    heading="Unsere Vorteile"
    features={features}
  />

  <!-- Product overview section -->
  <section class="product-info" aria-labelledby="product-heading">
    <div class="product-info__inner">
      <h2 id="product-heading" class="product-info__heading">Unsere Leistungen</h2>
      <p class="product-info__sub">Alle Einheiten werden auf Wunsch individuell ausgestattet. Sprechen Sie uns an.</p>
      <ul class="product-grid" role="list">
        <li class="product-card product-card--featured">
          <span class="product-card__badge">Beliebt</span>
          <span class="product-card__size">20 Fuß</span>
          <span class="product-card__use">Wohneinheit, ca. 15 m²</span>
          <ul class="product-card__features">
            <li>Wohn- & Schlafbereich</li>
            <li>Küchenzeile möglich</li>
            <li>Sanitärbereich optional</li>
          </ul>
          <span class="product-card__cta">Preis auf Anfrage</span>
        </li>
        <li class="product-card">
          <span class="product-card__size">Kombination</span>
          <span class="product-card__use">Mehrere Einheiten</span>
          <ul class="product-card__features">
            <li>Individuell konfigurierbar</li>
            <li>Innenverbindung möglich</li>
            <li>Gemeinschaftsräume</li>
          </ul>
          <span class="product-card__cta">Preis auf Anfrage</span>
        </li>
      </ul>
    </div>
  </section>

  <Benefits />

  <LandingForm
    ctaLabel="Jetzt Angebot anfragen"
    gtmLabel={gtmLabel}
    selectVariant="wohn-groesse"
    showFirmaField={true}
    containerLabel="einen Wohncontainer"
    formHeading="Kontakt – Kostenloses Angebot"
    formSubheading="Teilen Sie uns Ihre gewünschte Größe mit – wir melden uns innerhalb von 3 Stunden mit einem Festpreisangebot."
  />
</LandingLayout>

<style>
  .product-info {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .product-info__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
    text-align: center;
  }

  .product-info__heading {
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .product-info__sub {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .product-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    max-width: 42rem;
    margin-inline: auto;
  }

  .product-card {
    position: relative;
    background-color: var(--color-surface-alt);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    text-align: center;
    transition: border-color var(--duration-fast);
  }

  .product-card--featured {
    border-color: var(--color-brand-primary);
    background-color: color-mix(in srgb, var(--color-brand-primary) 5%, white);
  }

  .product-card__badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-brand-primary);
    color: white;
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
  }

  .product-card__size {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--color-brand-primary);
    line-height: 1;
  }

  .product-card__use {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .product-card__features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-text);
    margin-top: 0.5rem;
  }

  .product-card__cta {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-brand-accent);
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .product-grid {
      grid-template-columns: 1fr;
      max-width: 22rem;
    }
  }
</style>
