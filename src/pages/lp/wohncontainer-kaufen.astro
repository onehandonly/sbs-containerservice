---
const target = '/lp/containeranlagen-kaufen';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`https://anfrage.sbs-container.de${target}`} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Weiterleitung – SBS Containerservice GmbH</title>
    <script set:html={`window.location.replace(${JSON.stringify(target)});`}></script>
  </head>
  <body>
    <p>Diese Seite wurde umbenannt. Falls Sie nicht automatisch weitergeleitet werden: <a href={target}>Zur neuen Seite</a>.</p>
  </body>
</html>
