---
import LandingLayout from '../../layouts/LandingLayout.astro';
import LandingHero from '../../components/lp/LandingHero.astro';
import LandingFeatures from '../../components/lp/LandingFeatures.astro';
import LandingForm from '../../components/lp/LandingForm.astro';

const gtmLabel = 'lp_gewerbe_entsorgung';

const features = [
  {
    icon: '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
    title: 'Rechnung & Quittung',
    body: 'Alle Leistungen werden ordentlich in Rechnung gestellt – vollständig buchhalterisch verwertbar.',
  },
  {
    icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    title: 'Dauerdienst & Rahmenvertrag',
    body: 'Regelmäßiger Bedarf? Wir vereinbaren feste Abholintervalle und Konditionen – planbar und budgetsicher.',
  },
  {
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    title: 'SLA & Zuverlässigkeit',
    body: 'Vereinbarte Lieferfenster werden eingehalten. Bei Verzögerungen proaktive Kommunikation – kein Rätselraten.',
  },
  {
    icon: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
    title: 'Bundesweit einsetzbar',
    body: 'Filialen, Baustellen, Niederlassungen – wir koordinieren Entsorgung auch über mehrere Standorte.',
  },
];
---

<LandingLayout
  title="Gewerbeentsorgung mit Container — Dauerdienst & Rechnung | SBS Containerservice"
  description="Professionelle Gewerbeentsorgung mit Container. Rechnung, Rahmenvertrag, SLA-Garantie. Für Handwerk, Handel und Industrie. Jetzt Gewerbeangebot anfragen."
  canonical="https://www.sbs-containerservice.de/lp/gewerbe-entsorgung"
>
  <LandingHero
    headline="Gewerbliche Containerentsorgung – maßgeschneidert für Ihr Unternehmen"
    subline="Für Handwerk, Einzelhandel und Industrie. Container auf Abruf, Dauerdienst-Vereinbarung, ordentliche Buchhaltungsbelege. Skalierbar mit Ihrem Betrieb."
    ctaLabel="Gewerbeangebot anfragen"
    ctaHref="#anfrage"
    gtmLabel={gtmLabel}
    badge="Für Gewerbe & Industrie"
  />

  <!-- SLA / Service promises -->
  <section class="sla-section" aria-labelledby="sla-heading">
    <div class="sla-section__inner">
      <h2 id="sla-heading" class="sla-section__heading">Unsere Service-Garantien für Gewerbekunden</h2>
      <div class="sla-grid">
        <div class="sla-card">
          <div class="sla-card__number">24h</div>
          <div class="sla-card__label">Lieferung nach Bestellung</div>
          <p class="sla-card__desc">Kurzfristige Containerlieferung — auch bei Engpässen auf Ihrer Baustelle.</p>
        </div>
        <div class="sla-card">
          <div class="sla-card__number">2h</div>
          <div class="sla-card__label">Antwortzeit auf Anfragen</div>
          <p class="sla-card__desc">Kein Warten. Ihr persönlicher Ansprechpartner meldet sich innerhalb von 2 Stunden.</p>
        </div>
        <div class="sla-card sla-card--highlight">
          <div class="sla-card__number">100%</div>
          <div class="sla-card__label">Entsorgungsnachweis</div>
          <p class="sla-card__desc">Jede Abholung mit offiziellem Nachweis — revisionssicher für Ihr Unternehmen.</p>
        </div>
        <div class="sla-card">
          <div class="sla-card__number">0</div>
          <div class="sla-card__label">Versteckte Kosten</div>
          <p class="sla-card__desc">Festpreisangebot vor Auftrag. Keine Nachberechnung ohne Ihre Zustimmung.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries served -->
  <section class="industries-section" aria-labelledby="industries-heading">
    <div class="industries-section__inner">
      <h2 id="industries-heading" class="industries-section__heading">Für welche Branchen arbeiten wir?</h2>
      <ul class="industries-list" role="list">
        <li class="industry-item">
          <span class="industry-item__icon" aria-hidden="true">🏗️</span>
          <span>Bauunternehmen & Handwerk</span>
        </li>
        <li class="industry-item">
          <span class="industry-item__icon" aria-hidden="true">🏪</span>
          <span>Einzelhandel & Logistik</span>
        </li>
        <li class="industry-item">
          <span class="industry-item__icon" aria-hidden="true">🏭</span>
          <span>Produktion & Industrie</span>
        </li>
        <li class="industry-item">
          <span class="industry-item__icon" aria-hidden="true">🏢</span>
          <span>Immobilienverwalter</span>
        </li>
        <li class="industry-item">
          <span class="industry-item__icon" aria-hidden="true">🌿</span>
          <span>Garten- & Landschaftsbau</span>
        </li>
        <li class="industry-item">
          <span class="industry-item__icon" aria-hidden="true">🔧</span>
          <span>Kfz-Betriebe & Werkstätten</span>
        </li>
      </ul>
    </div>
  </section>

  <LandingFeatures
    heading="Was Gewerbekunden bei uns schätzen"
    features={features}
  />

  <LandingForm
    ctaLabel="Gewerbeangebot anfragen"
    gtmLabel={gtmLabel}
    showFirmaField={true}
    selectVariant="anfrage-typ"
    formHeading="Gewerbeangebot anfordern"
    formSubheading="Für Dauerdienst, Rahmenvertrag oder Einzelauftrag. Ihr persönlicher Ansprechpartner meldet sich innerhalb von 2 Stunden."
  />
</LandingLayout>

<style>
  .sla-section {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    background-color: var(--color-brand-primary);
    color: white;
  }

  .sla-section__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
  }

  .sla-section__heading {
    font-size: var(--text-2xl);
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .sla-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .sla-card {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.25rem;
    text-align: center;
    transition: background-color var(--duration-fast);
  }

  .sla-card--highlight {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .sla-card__number {
    font-size: clamp(2rem, 1rem + 3vw, 3rem);
    font-weight: 900;
    color: var(--color-brand-accent);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .sla-card__label {
    font-size: var(--text-sm);
    font-weight: 700;
    margin-bottom: 0.75rem;
    opacity: 0.9;
  }

  .sla-card__desc {
    font-size: var(--text-xs);
    opacity: 0.7;
    line-height: 1.5;
  }

  /* Industries */
  .industries-section {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    background-color: var(--color-surface);
  }

  .industries-section__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
  }

  .industries-section__heading {
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
    text-align: center;
  }

  .industries-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
    max-width: 52rem;
    margin-inline: auto;
  }

  .industry-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .industry-item__icon {
    font-size: 1.5rem;
  }

  @media (max-width: 900px) {
    .sla-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .sla-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
