---
import LandingLayout from '../../layouts/LandingLayout.astro';
import LandingHero from '../../components/lp/LandingHero.astro';
import LandingFeatures from '../../components/lp/LandingFeatures.astro';
import Benefits from '../../components/sections/Benefits.astro';
import LandingForm from '../../components/lp/LandingForm.astro';

const gtmLabel = 'lp_lagercontainer';

const features = [
  {
    icon: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="17"/><line x1="9" y1="12" x2="9" y2="17"/><line x1="15" y1="12" x2="15" y2="17"/>',
    title: 'Trocken & sicher',
    body: 'Verschweißte Stahlkonstruktion, wetterfest und einbruchsicher. Ihr Material bleibt trocken und geschützt.',
  },
  {
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    title: 'Abschließbar & stabil',
    body: 'Hochwertige Verriegelung und robuste Konstruktion. Geeignet für schwere Maschinen und wertvolles Equipment.',
  },
  {
    icon: '<polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>',
    title: 'Sofort auf Ihrem Gelände',
    body: 'Schnelle Lieferung und Aufstellung auf Ihrem Grundstück, Betriebsgelände oder der Baustelle.',
  },
  {
    icon: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
    title: 'Faire Festpreise',
    body: 'Keine versteckten Kosten. Sie erhalten ein verbindliches Angebot vor Auftragserteilung.',
  },
];
---

<LandingLayout
  title="Lagercontainer kaufen – sicher & wetterfest | SBS Container GmbH"
  description="Lagercontainer kaufen: stabil, trocken, sofort lieferbar. Verschiedene Größen, faire Festpreise. Jetzt kostenloses Angebot anfordern!"
  canonical="https://anfrage.sbs-containerservice.de/lagercontainer-kaufen"
  lcpImage="/img/lagercontainer.jpg"
>
  <LandingHero
    headline="Lagercontainer kaufen – sicher, trocken, sofort lieferbar"
    subline="Hochwertige Lagercontainer für Gewerbe, Handwerk und Industrie. Verschiedene Größen, abschließbar, wetterfest – Festpreisangebot auf Anfrage."
    ctaLabel="Jetzt Angebot anfragen"
    ctaHref="#anfrage"
    gtmLabel={gtmLabel}
    badge="Kostenlos & unverbindlich"
    image="/img/lagercontainer.jpg"
    imageAlt="SBS Lagercontainer – wetterfest und abschließbar"
  />

  <LandingFeatures
    heading="Unsere Vorteile"
    features={features}
  />

  <!-- Product overview section -->
  <section class="product-info" aria-labelledby="product-heading">
    <div class="product-info__inner">
      <h2 id="product-heading" class="product-info__heading">Unsere Leistungen</h2>
      <p class="product-info__sub">Alle Einheiten mit Standardverriegelung und Doppelflügeltür. 20 Fuß und 40 Fuß auch als High Cube (+30 cm Höhe) verfügbar.</p>
      <ul class="product-grid" role="list">
        <li class="product-card">
          <span class="product-card__size">10 Fuß</span>
          <span class="product-card__use">Kompakt-Lager, ca. 7 m²</span>
          <ul class="product-card__features">
            <li>Ideal für Werkzeug & Material</li>
            <li>Leicht zu versetzen</li>
            <li>Abschließbar</li>
          </ul>
          <span class="product-card__cta">Preis auf Anfrage</span>
        </li>
        <li class="product-card">
          <span class="product-card__size">15 Fuß</span>
          <span class="product-card__use">Mittel-Lager, ca. 10 m²</span>
          <ul class="product-card__features">
            <li>Kompakt & geräumig</li>
            <li>Ideal für mittleren Bedarf</li>
            <li>Abschließbar</li>
          </ul>
          <span class="product-card__cta">Preis auf Anfrage</span>
        </li>
        <li class="product-card product-card--featured">
          <span class="product-card__badge">Beliebt</span>
          <span class="product-card__size">20 Fuß</span>
          <span class="product-card__use">Standard-Lager, ca. 14 m²</span>
          <ul class="product-card__features">
            <li>Auch als High Cube (+30 cm)</li>
            <li>Regalsystem nachrüstbar</li>
            <li>Hohe Nutzlast</li>
          </ul>
          <span class="product-card__cta">Preis auf Anfrage</span>
        </li>
        <li class="product-card">
          <span class="product-card__size">40 Fuß</span>
          <span class="product-card__use">Groß-Lager, ca. 29 m²</span>
          <ul class="product-card__features">
            <li>Auch als High Cube (+30 cm)</li>
            <li>Trennwände möglich</li>
            <li>Fenster & Beleuchtung optional</li>
          </ul>
          <span class="product-card__cta">Preis auf Anfrage</span>
        </li>
      </ul>

      <!-- Condition options -->
      <div class="product-options">
        <h3 class="product-options__heading">Verfügbare Zustände</h3>
        <ul class="product-options__list product-options__list--half" role="list">
          <li class="product-option">
            <strong>Gebraucht</strong>
            <span>Geprüft, funktionsfähig, sofort einsatzbereit</span>
          </li>
          <li class="product-option">
            <strong>Neuwertig (1× See-Reise)</strong>
            <span>Nur eine Verschiffung, nahezu neuer Zustand</span>
          </li>
        </ul>
      </div>

      <!-- Door options -->
      <div class="product-options">
        <h3 class="product-options__heading">Tür-Optionen für ausgewählte Modelle</h3>
        <ul class="product-options__list" role="list">
          <li class="product-option">
            <strong>Standard</strong>
            <span>Doppelflügeltür (eine Seite)</span>
          </li>
          <li class="product-option">
            <strong>Double Door</strong>
            <span>Doppelflügeltür vorne und hinten</span>
          </li>
          <li class="product-option">
            <strong>Side Door</strong>
            <span>Komplette rechte Seite öffenbar</span>
          </li>
          <li class="product-option">
            <strong>All Sides Open</strong>
            <span>Jede Seite komplett öffenbar</span>
          </li>
        </ul>
      </div>

      <!-- Optional upgrades -->
      <div class="product-options">
        <h3 class="product-options__heading">Optionale Ausstattung</h3>
        <ul class="product-options__list product-options__list--half" role="list">
          <li class="product-option">
            <strong>Stahlfußboden</strong>
            <span>Auf Anfrage verfügbar</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <Benefits />

  <LandingForm
    ctaLabel="Jetzt Angebot anfragen"
    gtmLabel={gtmLabel}
    selectVariant="lager-groesse"
    showFirmaField={true}
    formHeading="Kontakt – Kostenloses Angebot"
    formSubheading="Teilen Sie uns Ihre gewünschte Größe mit – wir melden uns innerhalb von 3 Stunden mit einem Festpreisangebot."
  />
</LandingLayout>

<style>
  .product-info {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .product-info__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
    text-align: center;
  }

  .product-info__heading {
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .product-info__sub {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .product-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    max-width: 64rem;
    margin-inline: auto;
  }

  .product-card {
    position: relative;
    background-color: var(--color-surface-alt);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    text-align: center;
    transition: border-color var(--duration-fast);
  }

  .product-card--featured {
    border-color: var(--color-brand-primary);
    background-color: color-mix(in srgb, var(--color-brand-primary) 5%, white);
  }

  .product-card__badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-brand-primary);
    color: white;
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
  }

  .product-card__size {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--color-brand-primary);
    line-height: 1;
  }

  .product-card__use {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .product-card__features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-text);
    margin-top: 0.5rem;
  }

  .product-card__cta {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-brand-accent);
    margin-top: 0.5rem;
  }

  .product-options {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .product-options__heading {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .product-options__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    max-width: 64rem;
    margin-inline: auto;
  }

  .product-options__list--half {
    grid-template-columns: repeat(2, 1fr);
    max-width: 40rem;
  }

  .product-option {
    background-color: var(--color-surface-alt);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .product-option strong {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-brand-primary);
  }

  .product-option span {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .product-grid {
      grid-template-columns: 1fr;
      max-width: 22rem;
    }

    .product-options__list {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
