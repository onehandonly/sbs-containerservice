---
import LandingLayout from '../../layouts/LandingLayout.astro';
import LandingHero from '../../components/lp/LandingHero.astro';
import LandingFeatures from '../../components/lp/LandingFeatures.astro';
import LandingForm from '../../components/lp/LandingForm.astro';

const gtmLabel = 'lp_container_mieten';

const features = [
  {
    icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
    title: 'Lieferung innerhalb 24h',
    body: 'Container werden in der Regel am nächsten Werktag geliefert – auf Wunsch auch kurzfristiger.',
  },
  {
    icon: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
    title: 'Faire Festpreise',
    body: 'Kein verstecktes Kleingedrucktes. Unser Angebot gilt ab Anfrage – inklusive Lieferung und Abholung.',
  },
  {
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    title: 'Zertifizierte Entsorgung',
    body: 'Alle Materialien werden nach gesetzlichen Vorgaben entsorgt und recycelt. Entsorgungsnachweis auf Wunsch.',
  },
  {
    icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    title: 'Für Privat & Gewerbe',
    body: 'Ob Haushaltsauflösung, Renovierung oder Baustelle – wir finden die richtige Containergröße für Sie.',
  },
];
---

<LandingLayout
  title="Container mieten in Ihrer Region — heute bestellen, morgen geliefert | SBS Containerservice"
  description="Container mieten leicht gemacht. Schnelle Lieferung, faire Festpreise, zertifizierte Entsorgung. Jetzt kostenloses Angebot anfragen – Antwort in 2h."
  canonical="https://www.sbs-containerservice.de/lp/container-mieten"
>
  <LandingHero
    headline="Container mieten – heute bestellen, morgen geliefert"
    subline="Zuverlässige Container-Lieferung für Privat und Gewerbe. Faire Festpreise, kurzfristige Verfügbarkeit – kostenlos anfragen in unter 2 Minuten."
    ctaLabel="Jetzt Angebot anfragen"
    ctaHref="#anfrage"
    gtmLabel={gtmLabel}
    badge="Kostenlos & unverbindlich"
  />

  <LandingFeatures
    heading="Warum SBS Containerservice?"
    features={features}
  />

  <!-- Price range section -->
  <section class="price-info" aria-labelledby="price-heading">
    <div class="price-info__inner">
      <h2 id="price-heading" class="price-info__heading">Preisbeispiele Container mieten</h2>
      <p class="price-info__sub">Transparente Richtwerte — Ihr individuelles Angebot erhalten Sie auf Anfrage.</p>
      <ul class="price-grid" role="list">
        <li class="price-card">
          <span class="price-card__size">5 m³</span>
          <span class="price-card__use">Kleinmengen, Sperrmüll</span>
          <span class="price-card__price">ab <strong>149 €</strong></span>
        </li>
        <li class="price-card price-card--featured">
          <span class="price-card__badge">Beliebt</span>
          <span class="price-card__size">10 m³</span>
          <span class="price-card__use">Renovierung, Bauschutt</span>
          <span class="price-card__price">ab <strong>199 €</strong></span>
        </li>
        <li class="price-card">
          <span class="price-card__size">20 m³</span>
          <span class="price-card__use">Großbaustellen, Gewerbe</span>
          <span class="price-card__price">ab <strong>299 €</strong></span>
        </li>
      </ul>
      <p class="price-info__note">Alle Preise inkl. Lieferung, Abholung und Entsorgungsgebühren. zzgl. MwSt.</p>
    </div>
  </section>

  <LandingForm
    ctaLabel="Jetzt Angebot anfragen"
    gtmLabel={gtmLabel}
    formHeading="Kostenloses Angebot in 2 Minuten"
    formSubheading="Füllen Sie das Formular aus – wir melden uns innerhalb von 2 Stunden mit einem Festpreisangebot."
  />
</LandingLayout>

<style>
  .price-info {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .price-info__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
    text-align: center;
  }

  .price-info__heading {
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .price-info__sub {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .price-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    max-width: 48rem;
    margin-inline: auto;
  }

  .price-card {
    position: relative;
    background-color: var(--color-surface-alt);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    text-align: center;
    transition: border-color var(--duration-fast);
  }

  .price-card--featured {
    border-color: var(--color-brand-primary);
    background-color: oklch(42% 0.18 240 / 5%);
  }

  .price-card__badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-brand-primary);
    color: white;
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
  }

  .price-card__size {
    font-size: 2rem;
    font-weight: 900;
    color: var(--color-brand-primary);
    line-height: 1;
  }

  .price-card__use {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .price-card__price {
    font-size: var(--text-base);
    color: var(--color-text);
    margin-top: 0.375rem;
  }

  .price-card__price strong {
    font-size: var(--text-xl);
    font-weight: 900;
    color: var(--color-brand-accent);
  }

  .price-info__note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: 1.5rem;
  }

  @media (max-width: 600px) {
    .price-grid {
      grid-template-columns: 1fr;
      max-width: 22rem;
    }
  }
</style>
