---
import Button from '../ui/Button.astro';

interface Props {
  headline: string;
  subline?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  headline,
  subline,
  ctaLabel = 'Jetzt anfragen',
  ctaHref = '#kontakt',
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__inner">
    <div class="hero__content">
      <div class="hero__badge">Direktkauf · Faire Preise · Schnelle Lieferung</div>
      <h1 id="hero-heading" class="hero__headline">
        {headline}
      </h1>
      {subline && (
        <p class="hero__subline">{subline}</p>
      )}
      <div class="hero__actions">
        <Button
          href={ctaHref}
          variant="primary"
          size="lg"
          data-gtm-event="cta_click"
          data-gtm-label="hero_primary"
        >
          {ctaLabel}
        </Button>
        <Button href="tel:+494282594650" variant="outline" size="lg" class="btn-call">
          Direkt anrufen
        </Button>
      </div>
      <ul class="hero__trust" aria-label="Vorteile">
        <li>✓ Über 25 Jahre Erfahrung</li>
        <li>✓ Lieferung innerhalb von 24 Stunden nach Zahlungseingang</li>
        <li>✓ Geprüfte Qualität</li>
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="hero__img-frame">
        <img
          src="/img/lagercontainer.avif"
          alt="SBS Container – sofort einsatzbereit"
          width="1090"
          height="818"
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
        <div class="hero__img-overlay">
          <div class="hero__img-badge">
            <span class="hero__img-badge-value">24h</span>
            <span class="hero__img-badge-label">Lieferzeit</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
    background: linear-gradient(
      135deg,
      var(--color-brand-primary) 0%,
      #0d2f52 100%
    );
    color: white;
    overflow: hidden;
  }

  .hero__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .hero__badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: oklch(75% 0.18 50);
    margin-bottom: 1.25rem;
  }

  .hero__headline {
    font-size: var(--text-hero);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
    max-width: 16ch;
  }

  .hero__subline {
    font-size: var(--text-lg);
    opacity: 0.85;
    max-width: 50ch;
    line-height: 1.55;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .hero__actions :global(.btn-call) {
    padding-inline: 2.5rem;
    padding-block: 1.25rem;
    border-color: rgba(255, 255, 255, 0.75);
    color: white;
  }

  .hero__actions :global(.btn-call:hover) {
    background-color: rgba(255, 255, 255, 0.15);
    color: white;
  }

  .hero__trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    opacity: 0.75;
  }

  /* Visual column */
  .hero__visual {
    position: relative;
  }

  .hero__img-frame {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow:
      0 0 0 1px oklch(100% 0 0 / 15%),
      0 24px 60px oklch(10% 0.02 240 / 40%);
    transform: perspective(1000px) rotateY(-3deg) rotateX(2deg);
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }

  .hero__img-frame:hover {
    transform: perspective(1000px) rotateY(0deg) rotateX(0deg);
  }

  .hero__img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .hero__img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, oklch(10% 0.03 240 / 30%) 0%, transparent 50%);
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
  }

  .hero__img-badge {
    background-color: oklch(62% 0.20 50);
    color: white;
    border-radius: var(--radius-md);
    padding: 0.625rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 4px 16px oklch(62% 0.20 50 / 40%);
  }

  .hero__img-badge-value {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
  }

  .hero__img-badge-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      order: -1;
    }

    .hero__img-frame {
      transform: none;
    }

    .hero__headline {
      max-width: unset;
    }
  }
</style>
