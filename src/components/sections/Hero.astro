---
import Button from '../ui/Button.astro';

interface Props {
  headline: string;
  subline?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  headline,
  subline,
  ctaLabel = 'Jetzt anfragen',
  ctaHref = '#kontakt',
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__inner">
    <h1 id="hero-heading" class="hero__headline">
      {headline}
    </h1>
    {subline && (
      <p class="hero__subline">{subline}</p>
    )}
    <div class="hero__actions">
      <Button
        href={ctaHref}
        variant="primary"
        size="lg"
        data-gtm-event="cta_click"
        data-gtm-label="hero_primary"
      >
        {ctaLabel}
      </Button>
      <Button href="tel:+49000000000" variant="outline" size="lg">
        Direkt anrufen
      </Button>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-section);
    background: linear-gradient(
      135deg,
      var(--color-brand-primary) 0%,
      oklch(30% 0.16 240) 100%
    );
    color: white;
  }

  .hero__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero__headline {
    font-size: var(--text-hero);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 18ch;
  }

  .hero__subline {
    font-size: var(--text-lg);
    opacity: 0.85;
    max-width: 55ch;
    line-height: 1.5;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }
</style>
