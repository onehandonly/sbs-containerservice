---
interface Props {
  phone?: string;
}

const { phone = '+49 (0) 4282 594650' } = Astro.props;
---

<section id="kontakt" class="contact" aria-labelledby="contact-heading">
  <div class="contact__inner">
    <div class="contact__info">
      <h2 id="contact-heading" class="contact__title">Jetzt anfragen</h2>
      <p class="contact__sub">
        Schildern Sie uns Ihr Projekt – wir melden uns in der Regel am selben Werktag zurück.
      </p>

      <ul class="contact__details" role="list">
        <li class="contact-detail">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.6 4.37 2 2 0 0 1 3.59 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.08 6.08l.98-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <div>
            <span class="contact-detail__label">Telefon</span>
            <a href={`tel:${phone.replace(/\s/g, '')}`} class="contact-detail__value" data-gtm-event="phone_click" data-gtm-label="contact_section">
              {phone}
            </a>
          </div>
        </li>
        <li class="contact-detail">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <div>
            <span class="contact-detail__label">E-Mail</span>
            <a href="mailto:info@sbs-containerservice.de" class="contact-detail__value" data-gtm-event="email_click" data-gtm-label="contact_section">
              info@sbs-containerservice.de
            </a>
          </div>
        </li>
        <li class="contact-detail">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <div>
            <span class="contact-detail__label">Erreichbarkeit</span>
            <span class="contact-detail__value">Mo–Do: 7:00–16:15 Uhr<br/>Fr: 7:00–13:00 Uhr</span>
          </div>
        </li>
      </ul>
    </div>

    <form
      class="contact__form"
      name="anfrage"
      method="POST"
      action="https://api.web3forms.com/submit"
      data-web3forms
      data-gtm-form="contact_form"
      data-gtm-event="form_submit"
      data-gtm-label="contact_form"
    >
      <!-- Web3Forms: Anfragen gehen an info@sbs-container.de -->
      <input type="hidden" name="access_key" value="91543341-0693-4017-8311-5600372de99d" />
      <input type="hidden" name="subject" value="Neue Anfrage - Kontaktformular (sbs-container.de)" />
      <input type="hidden" name="from_name" value="SBS Containerservice - Website" />
      <input type="hidden" name="redirect" value="https://anfrage.sbs-container.de/danke?submitted=1" />
      <input type="hidden" name="source" value="contact_form" />
      <!-- Honeypot anti-spam (Web3Forms) -->
      <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="form-row">
        <div class="form-field">
          <label for="name" class="form-label">Name <span aria-hidden="true">*</span></label>
          <input
            type="text"
            id="name"
            name="name"
            class="form-input"
            required
            autocomplete="name"
            placeholder="Max Mustermann"
          />
        </div>
        <div class="form-field">
          <label for="phone" class="form-label">Telefon</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            class="form-input"
            autocomplete="tel"
            placeholder="+49 123 456789"
          />
        </div>
      </div>

      <div class="form-field">
        <label for="email" class="form-label">E-Mail <span aria-hidden="true">*</span></label>
        <input
          type="email"
          id="email"
          name="email"
          class="form-input"
          required
          autocomplete="email"
          placeholder="max@beispiel.de"
        />
      </div>

      <div class="form-field">
        <label for="service" class="form-label">Leistung</label>
        <select id="service" name="service" class="form-input">
          <option value="">Bitte wählen …</option>
          <option value="buerocontainer">Bürocontainer</option>
          <option value="lagercontainer">Lagercontainer</option>
          <option value="sanitaercontainer">Sanitärcontainer</option>
          <option value="baustellencontainer">Baustellencontainer</option>
          <option value="containeranlage">Containeranlage</option>
          <option value="sonstiges">Sonstiges</option>
        </select>
      </div>

      <div class="form-field">
        <label for="lieferung" class="form-label">Lieferung / Abholung</label>
        <select id="lieferung" name="lieferung" class="form-input">
          <option value="">Bitte wählen …</option>
          <option value="selbstabholung">Selbstabholung</option>
          <option value="lieferung-ohne-entladung">Lieferung ohne Entladung</option>
          <option value="lieferung-mit-entladung">Lieferung mit Entladung</option>
        </select>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="strasse" class="form-label">Straße + Nr.</label>
          <input type="text" id="strasse" name="strasse" class="form-input" autocomplete="street-address" placeholder="Musterstraße 1" />
        </div>
        <div class="form-field">
          <label for="ort" class="form-label">Ort</label>
          <input type="text" id="ort" name="ort" class="form-input" autocomplete="address-level2" placeholder="Musterstadt" />
        </div>
      </div>

      <div class="form-field">
        <label for="land" class="form-label">Land</label>
        <input
          type="text"
          id="land"
          name="land"
          class="form-input form-input--readonly"
          value="Deutschland"
          readonly
          tabindex="-1"
          aria-readonly="true"
          autocomplete="country-name"
        />
      </div>

      <div class="form-field">
        <label for="message" class="form-label">Nachricht <span aria-hidden="true">*</span></label>
        <textarea
          id="message"
          name="message"
          class="form-input form-textarea"
          required
          rows="4"
        >Sehr geehrtes SBS Team, ich interessiere mich für ...</textarea>
      </div>

      <div class="form-field form-privacy">
        <label class="form-checkbox-label">
          <input type="checkbox" name="privacy" required class="form-checkbox" />
          <span>Ich habe die <a href="/datenschutz" class="form-link">Datenschutzerklärung</a> gelesen und stimme zu. <span aria-hidden="true">*</span></span>
        </label>
      </div>

      <button type="submit" class="form-submit" data-gtm-event="cta_click" data-gtm-label="form_submit">
        Anfrage senden
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>

      <p class="form-note">* Pflichtfelder. Ihre Daten werden vertraulich behandelt.</p>
    </form>
  </div>
</section>

<script>
  import '../../scripts/web3forms.ts';
</script>

<style>
  .contact {
    padding-block: var(--space-section);
    background-color: var(--color-surface);
  }

  .contact__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(2rem, 1rem + 5vw, 5rem);
    align-items: start;
  }

  .contact__title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .contact__sub {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .contact__details {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-detail {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    color: var(--color-brand-primary);
  }

  .contact-detail svg {
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  .contact-detail__label {
    display: block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .contact-detail__value {
    display: block;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  .contact-detail__value:hover {
    color: var(--color-brand-primary);
  }

  /* Form */
  .contact__form {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.5rem);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .form-label span[aria-hidden] {
    color: var(--color-brand-accent);
    margin-left: 0.1em;
  }

  .form-input {
    font-family: inherit;
    font-size: var(--text-base);
    color: var(--color-text);
    background-color: var(--color-surface-alt);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.875rem;
    width: 100%;
    transition: border-color var(--duration-fast), box-shadow var(--duration-fast);
    appearance: none;
    -webkit-appearance: none;
  }

  .form-input--readonly {
    color: var(--color-text-muted);
    cursor: not-allowed;
  }

  .form-input:focus-visible {
    outline: none;
    border-color: var(--color-brand-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-brand-primary) 15%, transparent);
  }

  .form-textarea {
    resize: vertical;
    min-height: 8rem;
    line-height: 1.5;
  }

  .form-privacy {
    flex-direction: row;
    align-items: flex-start;
    gap: 0;
  }

  .form-checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
    cursor: pointer;
  }

  .form-checkbox {
    width: 1rem;
    height: 1rem;
    margin-top: 0.15rem;
    accent-color: var(--color-brand-primary);
    flex-shrink: 0;
  }

  .form-link {
    color: var(--color-brand-primary);
  }

  .form-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--color-brand-primary);
    color: white;
    font-family: inherit;
    font-size: var(--text-base);
    font-weight: 700;
    border: none;
    border-radius: var(--radius-md);
    padding: 0.875rem 1.5rem;
    cursor: pointer;
    transition: background-color var(--duration-fast), transform var(--duration-fast);
    width: 100%;
  }

  .form-submit:hover {
    background-color: #133d6b;
    transform: translateY(-1px);
  }

  .form-submit:active {
    transform: translateY(0);
  }

  .form-note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 768px) {
    .contact__inner {
      grid-template-columns: 1fr;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
