---
const services = [
  {
    image: '/img/buerocontainer.avif',
    imageAlt: 'Bürocontainer SBS',
    title: 'Bürocontainer',
    description: 'Wärmegedämmt, elektrifiziert und sofort einsatzbereit – als flexible Lösung für Baustellen, temporäre Büros und Verwaltung.',
    href: '/lp/buerocontainer-kaufen',
  },
  {
    image: '/img/lagercontainer.avif',
    imageAlt: 'Lagercontainer SBS',
    title: 'Lagercontainer',
    description: 'Sichere und witterungsbeständige Lagercontainer für Material, Werkzeuge und Waren – ideal für Gewerbe und Industrie.',
    href: '/lp/lagercontainer-kaufen',
  },
  {
    image: '/img/sanitaercontainer.avif',
    imageAlt: 'Sanitärcontainer SBS',
    title: 'Sanitärcontainer',
    description: 'Voll ausgestattete Sanitärcontainer für Baustellen und Veranstaltungen – hygienisch, zuverlässig und sofort einsatzbereit.',
    href: '/lp/sanitaercontainer-kaufen',
  },
  {
    image: '/img/containeranlagen.avif',
    imageAlt: 'Containeranlagen SBS',
    title: 'Containeranlagen',
    description: 'Individuelle Containeranlagen aus mehreren Modulen – maßgeschneidert für Ihr Projekt. Büro-, Sanitär- und Lagereinheiten kombiniert.',
    href: '/lp/containeranlagen-kaufen',
  },
];
---

<section id="leistungen" class="services" aria-labelledby="services-heading">
  <div class="services__inner">
    <header class="section-header">
      <h2 id="services-heading" class="section-header__title">Unsere Container</h2>
      <p class="section-header__sub">Direkt kaufen – fair bepreist, schnell geliefert, sofort einsatzbereit.</p>
    </header>

    <ul class="services__grid" role="list">
      {services.map((s) => (
        <li class="service-card">
          <a href={s.href} class="service-card__link" tabindex="-1" aria-hidden="true">
            <div class="service-card__img-wrap">
              <img
                src={s.image}
                alt={s.imageAlt}
                width="400"
                height="300"
                loading="lazy"
                class="service-card__img"
              />
            </div>
          </a>
          <div class="service-card__body">
            <h3 class="service-card__title">
              <a href={s.href} class="service-card__title-link">{s.title}</a>
            </h3>
            <p class="service-card__desc">{s.description}</p>
            <a href={s.href} class="service-card__cta">
              Mehr erfahren
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          </div>
        </li>
      ))}
    </ul>

    <!-- Schnelle Lieferung strip -->
    <div class="services__cta-strip">
      <div class="services__cta-strip-text">
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/>
          <rect x="9" y="11" width="14" height="10" rx="2"/>
          <circle cx="12" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
        </svg>
        <span>Schnelle Lieferung in Ihre Region – kurzfristig und flexibel</span>
      </div>
      <a href="#kontakt" class="services__cta-btn">Jetzt Angebot anfragen</a>
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: var(--space-section);
    background-color: var(--color-surface-alt);
  }

  .services__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
  }

  .section-header {
    text-align: center;
    margin-bottom: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
  }

  .section-header__title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .section-header__sub {
    margin-top: 0.75rem;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 52ch;
    margin-inline: auto;
    line-height: 1.5;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
    list-style: none;
    margin-bottom: 2.5rem;
  }

  .service-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow var(--duration-normal) var(--ease-out-expo),
                transform var(--duration-normal) var(--ease-out-expo);
  }

  .service-card:hover {
    box-shadow: var(--shadow-md, 0 8px 32px oklch(18% 0.02 240 / 12%));
    transform: translateY(-3px);
  }

  .service-card__link {
    display: block;
  }

  .service-card__img-wrap {
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .service-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }

  .service-card:hover .service-card__img {
    transform: scale(1.04);
  }

  .service-card__body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
  }

  .service-card__title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .service-card__title-link {
    color: inherit;
    text-decoration: none;
  }

  .service-card__title-link:hover {
    color: var(--color-brand-primary);
  }

  .service-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    flex: 1;
    margin: 0;
  }

  .service-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-brand-primary);
    text-decoration: none;
    margin-top: 0.5rem;
    transition: gap var(--duration-fast);
  }

  .service-card__cta:hover {
    gap: 0.625rem;
  }

  /* CTA strip */
  .services__cta-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background-color: var(--color-brand-primary);
    color: white;
    border-radius: var(--radius-lg);
    padding: 1.5rem 2rem;
    flex-wrap: wrap;
  }

  .services__cta-strip-text {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    font-size: var(--text-base);
    font-weight: 600;
    opacity: 0.95;
  }

  .services__cta-strip-text svg {
    flex-shrink: 0;
    opacity: 0.8;
  }

  .services__cta-btn {
    display: inline-flex;
    align-items: center;
    background-color: oklch(62% 0.20 50);
    color: white;
    font-weight: 800;
    font-size: var(--text-sm);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--duration-fast), transform var(--duration-fast);
  }

  .services__cta-btn:hover {
    background-color: oklch(55% 0.22 50);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .services__cta-strip {
      flex-direction: column;
      text-align: center;
    }
    .services__cta-strip-text {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
