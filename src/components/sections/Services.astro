---
const services = [
  {
    icon: 'container',
    title: 'Container mieten',
    description: 'Abrollcontainer und Absetzcontainer in verschiedenen Größen – für Bauschutt, Sperrmüll, Grünschnitt und mehr.',
  },
  {
    icon: 'truck',
    title: 'Schnelle Lieferung',
    description: 'Kurzfristige Lieferung und Abholung in Ihrer Region. Wir koordinieren den Termin nach Ihren Wünschen.',
  },
  {
    icon: 'recycle',
    title: 'Entsorgung & Recycling',
    description: 'Fachgerechte und umweltgerechte Entsorgung aller gängigen Materialien. Einhaltung aller gesetzlichen Vorschriften.',
  },
  {
    icon: 'building',
    title: 'Gewerbe & Industrie',
    description: 'Dauerhafter Container-Service für Unternehmen und Baustellen. Individuelle Rahmenverträge auf Anfrage.',
  },
];
---

<section id="leistungen" class="services" aria-labelledby="services-heading">
  <div class="services__inner">
    <header class="section-header">
      <h2 id="services-heading" class="section-header__title">Unsere Leistungen</h2>
      <p class="section-header__sub">Alles aus einer Hand – schnell, zuverlässig und zu fairen Preisen.</p>
    </header>

    <ul class="services__grid" role="list">
      {services.map((s) => (
        <li class="service-card">
          <div class="service-card__icon" aria-hidden="true">
            {s.icon === 'container' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2"/>
                <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                <line x1="12" y1="12" x2="12" y2="17"/>
                <line x1="9" y1="12" x2="9" y2="17"/>
                <line x1="15" y1="12" x2="15" y2="17"/>
              </svg>
            )}
            {s.icon === 'truck' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/>
                <rect x="9" y="11" width="14" height="10" rx="2"/>
                <circle cx="12" cy="21" r="1"/>
                <circle cx="20" cy="21" r="1"/>
              </svg>
            )}
            {s.icon === 'recycle' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="1 4 1 10 7 10"/>
                <polyline points="23 20 23 14 17 14"/>
                <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4-4.64 4.36A9 9 0 0 1 3.51 15"/>
              </svg>
            )}
            {s.icon === 'building' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="2" width="16" height="20" rx="2"/>
                <path d="M9 22v-4h6v4"/>
                <path d="M8 6h.01M16 6h.01M8 10h.01M16 10h.01M8 14h.01M16 14h.01"/>
              </svg>
            )}
          </div>
          <h3 class="service-card__title">{s.title}</h3>
          <p class="service-card__desc">{s.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    padding-block: var(--space-section);
    background-color: var(--color-surface-alt);
  }

  .services__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
  }

  .section-header {
    text-align: center;
    margin-bottom: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
  }

  .section-header__title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .section-header__sub {
    margin-top: 0.75rem;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 52ch;
    margin-inline: auto;
    line-height: 1.5;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.5rem;
    list-style: none;
  }

  .service-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 1rem + 1.25vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: box-shadow var(--duration-normal) var(--ease-out-expo),
                transform var(--duration-normal) var(--ease-out-expo);
  }

  .service-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .service-card__icon {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface-alt);
    border-radius: var(--radius-md);
    color: var(--color-brand-primary);
    flex-shrink: 0;
  }

  .service-card__title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
  }

  .service-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }
</style>
