---
interface Feature {
  icon: string; // SVG path data
  title: string;
  body: string;
}

interface Props {
  heading: string;
  features: Feature[];
}

const { heading, features } = Astro.props;
---

<section class="lp-features" aria-labelledby="lp-features-heading">
  <div class="lp-features__inner">
    <h2 id="lp-features-heading" class="lp-features__heading">{heading}</h2>
    <ul class="lp-features__grid" role="list">
      {features.map((f) => (
        <li class="feature-card">
          <div class="feature-card__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <Fragment set:html={f.icon} />
            </svg>
          </div>
          <div>
            <h3 class="feature-card__title">{f.title}</h3>
            <p class="feature-card__body">{f.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .lp-features {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
    background-color: var(--color-surface);
  }

  .lp-features__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
  }

  .lp-features__heading {
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
    text-align: center;
  }

  .lp-features__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .feature-card__icon {
    background-color: var(--color-brand-primary);
    color: white;
    border-radius: var(--radius-md);
    padding: 0.625rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.375rem;
  }

  .feature-card__body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
  }
</style>
