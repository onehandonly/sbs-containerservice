---
interface Props {
  headline: string;
  subline: string;
  ctaLabel: string;
  ctaHref?: string;
  gtmLabel: string;
  badge?: string;
}

const {
  headline,
  subline,
  ctaLabel,
  ctaHref = '#anfrage',
  gtmLabel,
  badge,
} = Astro.props;
---

<section class="lp-hero" aria-labelledby="lp-hero-heading">
  <div class="lp-hero__inner">
    <div class="lp-hero__content">
      {badge && (
        <div class="lp-hero__badge" aria-label="Angebot">{badge}</div>
      )}
      <h1 id="lp-hero-heading" class="lp-hero__headline">{headline}</h1>
      <p class="lp-hero__subline">{subline}</p>

      <!-- Trust signals inline -->
      <ul class="lp-hero__trust" role="list" aria-label="Vertrauenssignale">
        <li class="trust-item">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
          </svg>
          <span>Über 25 Jahre Erfahrung</span>
        </li>
        <li class="trust-item">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Lieferung innerhalb 24h</span>
        </li>
        <li class="trust-item">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Geprüfte Containerqualität</span>
        </li>
        <li class="trust-item">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Faire Festpreise</span>
        </li>
      </ul>

      <div class="lp-hero__cta-group">
        <a
          href={ctaHref}
          class="lp-hero__cta lp-hero__cta--primary"
          data-gtm-event="cta_click"
          data-gtm-label={gtmLabel}
        >
          {ctaLabel}
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        <a
          href="tel:+494282594650"
          class="lp-hero__cta lp-hero__cta--phone"
          data-gtm-event="phone_click"
          data-gtm-label={gtmLabel}
        >
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.6 4.37 2 2 0 0 1 3.59 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.08 6.08l.98-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Direkt anrufen
        </a>
      </div>
    </div>

    <!-- Visual: review stars widget -->
    <div class="lp-hero__social-proof" aria-label="Kundenbewertungen">
      <div class="review-card">
        <div class="review-card__stars" aria-label="5 von 5 Sternen">
          {Array.from({ length: 5 }).map(() => (
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
          ))}
        </div>
        <p class="review-card__text">"Schnelle Lieferung, top Service. Container war pünktlich und die Abholung lief reibungslos."</p>
        <p class="review-card__author">— Thomas K., Geschäftskunde</p>
        <div class="review-card__meta">
          <span class="review-card__score">4,9</span>
          <span class="review-card__count">aus 200+ Bewertungen</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .lp-hero {
    background: linear-gradient(135deg, var(--color-brand-primary) 0%, #0f3460 100%);
    color: white;
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
  }

  .lp-hero__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .lp-hero__badge {
    display: inline-block;
    background-color: var(--color-brand-accent);
    color: white;
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .lp-hero__headline {
    font-size: clamp(2rem, 1rem + 5vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .lp-hero__subline {
    font-size: var(--text-lg);
    opacity: 0.87;
    line-height: 1.55;
    max-width: 52ch;
    margin-bottom: 1.75rem;
  }

  .lp-hero__trust {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-bottom: 2rem;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-sm);
    font-weight: 600;
    opacity: 0.9;
  }

  .trust-item svg {
    color: var(--color-brand-accent);
    flex-shrink: 0;
  }

  .lp-hero__cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    align-items: center;
  }

  .lp-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: inherit;
    font-size: var(--text-base);
    font-weight: 700;
    border-radius: var(--radius-md);
    padding: 0.875rem 1.5rem;
    text-decoration: none;
    transition: transform var(--duration-fast), opacity var(--duration-fast);
    cursor: pointer;
  }

  .lp-hero__cta:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }

  .lp-hero__cta:active {
    transform: translateY(0);
  }

  .lp-hero__cta--primary {
    background-color: var(--color-brand-accent);
    color: white;
    box-shadow: 0 4px 20px color-mix(in srgb, var(--color-brand-accent) 40%, transparent);
  }

  .lp-hero__cta--phone {
    background-color: transparent;
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.35);
  }

  .lp-hero__cta--phone:hover {
    border-color: rgba(255, 255, 255, 0.6);
  }

  /* Social proof card */
  .lp-hero__social-proof {
    display: flex;
    justify-content: center;
  }

  .review-card {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    max-width: 26rem;
    width: 100%;
  }

  .review-card__stars {
    display: flex;
    gap: 0.25rem;
    color: var(--color-brand-accent);
    margin-bottom: 1rem;
  }

  .review-card__text {
    font-size: var(--text-base);
    line-height: 1.6;
    opacity: 0.9;
    font-style: italic;
    margin-bottom: 0.875rem;
  }

  .review-card__author {
    font-size: var(--text-sm);
    font-weight: 600;
    opacity: 0.75;
    margin-bottom: 1.25rem;
  }

  .review-card__meta {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 1rem;
  }

  .review-card__score {
    font-size: 2rem;
    font-weight: 900;
    color: var(--color-brand-accent);
    line-height: 1;
  }

  .review-card__count {
    font-size: var(--text-sm);
    opacity: 0.75;
  }

  @media (max-width: 768px) {
    .lp-hero__inner {
      grid-template-columns: 1fr;
    }

    .lp-hero__social-proof {
      order: -1;
    }

    .review-card {
      max-width: 100%;
    }
  }
</style>
