---
interface Props {
  phone?: string;
}

const { phone = '+49 (0) 4282 594650' } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label="SBS Containerservice – Startseite">
      <img src="/sbs-logo.svg" alt="SBS Containerservice" class="site-header__logo-img" width="208" height="69" />
    </a>

    <nav aria-label="Hauptnavigation" class="site-header__nav">
      <a href="#leistungen">Leistungen</a>
      <a href="#vorteile">Vorteile</a>
      <a href="#kontakt">Kontakt</a>
    </nav>

    <a
      href={`tel:${phone.replace(/\s/g, '')}`}
      class="site-header__cta"
      data-gtm-event="phone_click"
      data-gtm-label="header"
    >
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.6 4.37 2 2 0 0 1 3.59 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.08 6.08l.98-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      {phone}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-gap);
    height: 4rem;
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-header__logo-img {
    height: 3.25rem;
    width: auto;
  }

  .site-header__nav {
    display: flex;
    gap: 1.75rem;
    margin-left: auto;
  }

  .site-header__nav a {
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: color var(--duration-fast);
  }

  .site-header__nav a:hover {
    color: var(--color-brand-primary);
  }

  .site-header__cta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--color-brand-primary);
    font-weight: 600;
    font-size: var(--text-sm);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .site-header__cta:hover {
    color: var(--color-brand-accent);
  }

  @media (max-width: 640px) {
    .site-header__nav {
      display: none;
    }

    .site-header__logo-text {
      display: none;
    }
  }
</style>
