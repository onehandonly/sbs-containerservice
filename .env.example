# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
# Production builds fall back to this container when the variable is unset;
# override here to point local/staging builds at a different container.
PUBLIC_GTM_ID=GTM-KRHWHQ22

# Google Ads conversion IDs (populated when GTM is set up)
PUBLIC_GADS_CONVERSION_ID=
PUBLIC_GADS_CONVERSION_LABEL=

# Site URL used for canonical links and OG tags
PUBLIC_SITE_URL=https://www.sbs-containerservice.de
